# Variables de entorno del Frontend — Super Amigos Grooming Spa
# Copiar este archivo como .env y completar con los valores reales.
# NUNCA commitear el .env — está en .gitignore.

# URL base de la API del backend
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Clave de la API de Google Maps, usada en la pantalla de emergencia (RF-011).
# NUNCA escribir esta clave directamente en el código — solo aquí, en el .env local.
VITE_MAPS_API_KEY=your-google-maps-api-key
